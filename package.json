{
  "name": "dsh-overleaf-workshop",
  "version": "0.4.11",
  "description": "Overleaf Workshop for DeepSeek Harness: three-column workspace, live sync, server compile and PDF preview.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "node test/run.mjs",
    "build:editor": "node scripts/build-editor.mjs",
    "check:editor": "node scripts/build-editor.mjs --check"
  },
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./client": "./ui/client.js"
  },
  "files": [
    "index.js",
    "lib",
    "ui",
    "scripts/profile.mjs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-workspace"
      ]
    }
  },
  "engines": {
    "node": ">=20"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenqaq123/dsh-overleaf-workshop.git"
  },
  "homepage": "https://github.com/chenqaq123/dsh-overleaf-workshop#readme",
  "bugs": {
    "type": "url",
    "url": "https://github.com/chenqaq123/dsh-overleaf-workshop/issues"
  },
  "keywords": [
    "deepseek",
    "harness",
    "overleaf",
    "overleaf-workshop",
    "latex"
  ],
  "bin": {
    "dsh-overleaf-workshop": "scripts/profile.mjs"
  },
  "dependencies": {
    "diff-match-patch": "^1.0.5",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.0",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lezer/highlight": "^1.2.5",
    "esbuild": "^0.28.2"
  }
}
